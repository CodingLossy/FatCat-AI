#
# 复制为 .env 后修改(.env 已被 .gitignore 忽略,不要提交)。完整说明见 docs/deploy/docker.md。

# 你的域名,A / AAAA 记录需指向本机公网 IP
FATCAT_AI_DOMAIN=fatcat.example.com
# Let's Encrypt 到期提醒用的邮箱
ACME_EMAIL=admin@example.com

# 首次创建主人账户用的设置码(至少 8 位,随机生成)。留空则从 `docker compose logs fatcat-ai` 里取一次性设置码
FATCAT_AI_SETUP_CODE=

# 修改版部署者:填你的修改版源码地址(AGPL §13)
FATCAT_AI_SOURCE_URL=

# 使用已发布的镜像时取消注释并改成实际标签(见 docs/deploy/docker.md「升级」)
# FATCAT_AI_IMAGE=ghcr.io/codinglossy/fatcat-ai:TAG

# 用 DNS-01 验证(docker-compose.dnspod.yml)时才需要:腾讯云 API 密钥文件的路径,见 docs/deploy/docker.md
# TENCENTCLOUD_SECRET_ID_PATH=./secrets/tencentcloud_secret_id
# TENCENTCLOUD_SECRET_KEY_PATH=./secrets/tencentcloud_secret_key
